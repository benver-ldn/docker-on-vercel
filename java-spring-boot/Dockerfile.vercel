# ---- Stage 1: build the fat JAR with Maven (no local Java/Maven needed) ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

# Cache dependencies first so this layer is reused unless pom.xml changes.
COPY pom.xml .
RUN mvn -q -B dependency:go-offline

# Build the application.
COPY src ./src
RUN mvn -q -B -DskipTests package

# ---- Stage 2: slim runtime image ----
FROM eclipse-temurin:21-jre
WORKDIR /app

# Exactly one *.jar is produced by spring-boot-maven-plugin (the .jar.original is not matched).
COPY --from=build /build/target/*.jar /app/app.jar

# Vercel routes container-function traffic to port 80 by default.
ENV PORT=80
EXPOSE 80

# Hard-cap the JVM heap. Without this, Java auto-sizes its heap from the
# container's detected memory; if the runtime doesn't convey a memory limit,
# the JVM over-reserves and is OOM-killed at startup before it can log.
# JAVA_TOOL_OPTIONS is also echoed to stderr on boot, giving us an early
# "process started" signal even if something later fails.
ENV JAVA_TOOL_OPTIONS="-Xmx512m"

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
