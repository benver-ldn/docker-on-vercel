# ---- Stage 1: build the fat JAR with Maven (no local Java/Maven needed) ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

# Cache dependencies first so this layer is reused unless pom.xml changes.
COPY pom.xml .
RUN mvn -q -B dependency:go-offline

# Build the application.
COPY src ./src
RUN mvn -q -B -DskipTests package

# ---- Stage 2: slim runtime image ----
FROM eclipse-temurin:21-jre
WORKDIR /app

# Exactly one *.jar is produced by spring-boot-maven-plugin (the .jar.original is not matched).
COPY --from=build /build/target/*.jar /app/app.jar

# Vercel routes container-function traffic to port 80 by default.
ENV PORT=80
EXPOSE 80

# JVM tuning for fast cold start in a constrained container:
#  -Xmx512m               hard-cap heap (avoid startup OOM if the runtime
#                         doesn't convey a memory limit to the JVM)
#  -XX:TieredStopAtLevel=1 stop JIT at C1 — much faster startup
#  -XX:+UseSerialGC        no parallel-GC init overhead on 1 vCPU / tiny heap
#  -Xss512k                smaller thread stacks
#  -Djava.net.preferIPv4Stack=true
#                         bind the HTTP server on the IPv4 stack (0.0.0.0:80).
#                         By default the JVM binds the IPv6 wildcard [::]:80 and
#                         relies on OS dual-stack to also accept IPv4. Vercel's
#                         container runtime reaches the app over IPv4 without that
#                         dual-stack mapping, so an IPv6-only listener is
#                         unreachable and every request fails with
#                         INTERNAL_FUNCTION_INVOCATION_FAILED. Forcing IPv4 fixes it.
# JAVA_TOOL_OPTIONS is also echoed to stderr on boot, an early "process started" signal.
ENV JAVA_TOOL_OPTIONS="-Xmx512m -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xss512k -Djava.net.preferIPv4Stack=true"

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
