# ---- Stage 1: compile ----
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app
COPY Main.java .
RUN javac Main.java

# ---- Stage 2: slim runtime ----
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/Main.class .

# Vercel routes container-function traffic to port 80 by default.
ENV PORT=80
EXPOSE 80

# Call java by ABSOLUTE PATH. Vercel's container runtime does not honor the
# image's ENV PATH, and temurin installs java under /opt/java/openjdk/bin
# (a non-standard dir), so a bare "java" resolves to "java: not found" on
# Vercel and the JVM never starts. The absolute path removes the PATH dependency.
# Explicit IPv4 stack, on top of the 0.0.0.0 bind in Main.java.
CMD ["/opt/java/openjdk/bin/java", "-Djava.net.preferIPv4Stack=true", "-cp", ".", "Main"]
